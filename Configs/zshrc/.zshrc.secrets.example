# ~/.zshrc.secrets — machine-local secrets, never committed
# Copy this file to ~/.zshrc.secrets and fill in your real values.
# It is sourced automatically by .zshrc.

# Figma MCP server token
export FIGMA_ACCESS_TOKEN="your-figma-token-here"

# Brave Search API key
export BRAVE_API_KEY="your-brave-api-key-here"

# Notion integration token
export NOTION_TOKEN="your-notion-token-here"

# Playwright MCP Bridge extension token (WSL2 → Windows browser)
export PLAYWRIGHT_MCP_EXTENSION_TOKEN="your-playwright-token-here"
