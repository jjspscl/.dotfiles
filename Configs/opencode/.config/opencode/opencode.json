{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "uiui/gpt-5.6-luna",
  "permission": "allow",
  "provider": {
    "uiui": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "UIUI API",
      "options": {
        "baseURL": "https://api.uiuihao.com/v1",
        "apiKey": "{file:~/.local/share/opencode/uiui-key}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2 (UIUI)",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (UIUI)",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra (UIUI)",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (UIUI)",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "kimi-k3": {
          "name": "Kimi K3 (UIUI)",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 256000, "output": 8192 }
        },
        "qwen3-max": {
          "name": "Qwen 3 Max (UIUI)",
          "reasoning": true,
          "attachment": true,
          "interleaved": { "field": "reasoning_content" },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 131072 }
        }
      }
    },
    "uiui-claude": {
      "npm": "@ai-sdk/anthropic",
      "name": "UIUI Claude Native",
      "options": {
        "baseURL": "https://api.uiuihao.com/v1",
        "apiKey": "{file:~/.local/share/opencode/uiui-key}"
      },
      "models": {
        "claude-fable-5": {
          "name": "Claude Fable 5 (UIUI Native)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5 (UIUI Native)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 128000 }
