{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["engram", "mcp"],
      "environment": {
        "ENGRAM_DISABLE_CLOUD_SYNC": "1",
        "ENGRAM_DISABLE_TELEMETRY": "1",
        "ENGRAM_DISABLE_ANALYTICS": "1",
        "ENGRAM_DISABLE_UPDATE_CHECK": "1"
      },
      "enabled": true
    },
    "token-savior": {
      "type": "local",
      "command": ["/home/jjspscl/.opencode/token-savior-venv/bin/token-savior"],
      "environment": {
        "WORKSPACE_ROOTS": "/home/jjspscl/projects/cimic/mai",
        "TOKEN_SAVIOR_CLIENT": "opencode",
        "TOKEN_SAVIOR_PROFILE": "optimized",
        "TOKEN_SAVIOR_DISABLE_TELEGRAM": "1",
        "TOKEN_SAVIOR_DISABLE_DISCORD": "1",
        "TOKEN_SAVIOR_DISABLE_WEBHOOKS": "1",
        "TOKEN_SAVIOR_DISABLE_ANTHROPIC": "1"
      },
      "enabled": true
    }
  }
}
