          },
          "limit": { "context": 1000000, "output": 128000 }
        }
      }
    }
  },
  "instructions": ["~/.config/opencode/search-preferences.md"],
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["/home/jjspscl/.local/bin/engram", "mcp"],
      "environment": {
        "ENGRAM_DISABLE_CLOUD_SYNC": "1",
        "ENGRAM_DISABLE_TELEMETRY": "1",
        "ENGRAM_DISABLE_ANALYTICS": "1",
        "ENGRAM_DISABLE_UPDATE_CHECK": "1"
      },
      "enabled": true
    },
    "token-savior": {
      "type": "local",
      "command": ["/home/jjspscl/.opencode/token-savior-venv/bin/token-savior"],
      "environment": {
        "WORKSPACE_ROOTS": "/home/jjspscl/projects/cimic/mai",
        "TOKEN_SAVIOR_CLIENT": "opencode",
        "TOKEN_SAVIOR_PROFILE": "optimized",
        "TOKEN_SAVIOR_DISABLE_TELEGRAM": "1",
        "TOKEN_SAVIOR_DISABLE_DISCORD": "1",
        "TOKEN_SAVIOR_DISABLE_WEBHOOKS": "1",
        "TOKEN_SAVIOR_DISABLE_ANTHROPIC": "1"
      },
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": [
        "brave-search-mcp-server",
        "--transport",
        "stdio",
        "--disabled-tools",
        "brave_llm_context",
        "brave_summarizer"
      ],
      "environment": {
        "BRAVE_API_KEY": "{file:~/.local/share/opencode/brave-key}"
      },
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
      "headers": {
        "x-api-key": "{file:~/.local/share/opencode/exa-key}"
      },
      "enabled": true
    }
  },
  "plugins": []
}
