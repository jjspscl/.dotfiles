        "baseURL": "https://codex-api.jjspscl.com/v1",
        "apiKey": "{file:~/.local/share/opencode/codex-key}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (codex)",
