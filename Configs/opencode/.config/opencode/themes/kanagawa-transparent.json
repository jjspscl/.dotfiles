{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "ink": "#DCD7BA",
    "muted": "#727169",
    "fujiWhite": "#DCD7BA",
    "oldWhite": "#C8C093",
    "sumiInk3": "#1F1F28",
    "sumiInk4": "#2A2A37",
    "waveBlue1": "#223249",
    "waveBlue2": "#2D4F67",
    "autumnGreen": "#76946A",
    "autumnRed": "#C34043",
    "boatYellow2": "#C0A36E",
    "crystalBlue": "#7E9CD8",
    "oniViolet": "#957FB8",
    "springViolet1": "#938AA9"
  },
  "theme": {
    "primary": { "dark": "crystalBlue", "light": "waveBlue2" },
    "secondary": { "dark": "oniViolet", "light": "oniViolet" },
    "accent": { "dark": "oldWhite", "light": "boatYellow2" },
    "error": { "dark": "autumnRed", "light": "autumnRed" },
    "warning": { "dark": "boatYellow2", "light": "boatYellow2" },
    "success": { "dark": "autumnGreen", "light": "autumnGreen" },
    "info": { "dark": "crystalBlue", "light": "waveBlue2" },

    "text": { "dark": "fujiWhite", "light": "sumiInk3" },
    "textMuted": { "dark": "muted", "light": "springViolet1" },

    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "none", "light": "none" },
    "backgroundElement": { "dark": "none", "light": "none" },

    "border": { "dark": "sumiInk4", "light": "springViolet1" },
    "borderActive": { "dark": "waveBlue2", "light": "waveBlue2" },
    "borderSubtle": { "dark": "sumiInk3", "light": "springViolet1" },

    "diffAdded": { "dark": "autumnGreen", "light": "autumnGreen" },
    "diffRemoved": { "dark": "autumnRed", "light": "autumnRed" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "crystalBlue", "light": "waveBlue2" },
    "diffHighlightAdded": { "dark": "autumnGreen", "light": "autumnGreen" },
    "diffHighlightRemoved": { "dark": "autumnRed", "light": "autumnRed" },
    "diffAddedBg": { "dark": "none", "light": "none" },
    "diffRemovedBg": { "dark": "none", "light": "none" },
    "diffContextBg": { "dark": "none", "light": "none" },
    "diffLineNumber": { "dark": "muted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "none", "light": "none" },
    "diffRemovedLineNumberBg": { "dark": "none", "light": "none" },

    "markdownText": { "dark": "fujiWhite", "light": "sumiInk3" },
    "markdownHeading": { "dark": "crystalBlue", "light": "waveBlue2" },
    "markdownLink": { "dark": "crystalBlue", "light": "waveBlue2" },
    "markdownLinkText": { "dark": "oldWhite", "light": "boatYellow2" },
    "markdownCode": { "dark": "autumnGreen", "light": "autumnGreen" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "oniViolet", "light": "oniViolet" },
    "markdownStrong": { "dark": "oldWhite", "light": "boatYellow2" },
    "markdownHorizontalRule": { "dark": "sumiInk4", "light": "springViolet1" },
    "markdownListItem": { "dark": "crystalBlue", "light": "waveBlue2" },
    "markdownListEnumeration": { "dark": "oldWhite", "light": "boatYellow2" },
    "markdownImage": { "dark": "crystalBlue", "light": "waveBlue2" },
    "markdownImageText": { "dark": "oldWhite", "light": "boatYellow2" },
    "markdownCodeBlock": { "dark": "fujiWhite", "light": "sumiInk3" },

    "syntaxComment": { "dark": "muted", "light": "springViolet1" },
    "syntaxKeyword": { "dark": "oniViolet", "light": "oniViolet" },
    "syntaxFunction": { "dark": "crystalBlue", "light": "waveBlue2" },
    "syntaxVariable": { "dark": "fujiWhite", "light": "sumiInk3" },
    "syntaxString": { "dark": "autumnGreen", "light": "autumnGreen" },
    "syntaxNumber": { "dark": "boatYellow2", "light": "boatYellow2" },
    "syntaxType": { "dark": "oldWhite", "light": "boatYellow2" },
    "syntaxOperator": { "dark": "springViolet1", "light": "springViolet1" },
    "syntaxPunctuation": { "dark": "fujiWhite", "light": "sumiInk3" }
  }
}
